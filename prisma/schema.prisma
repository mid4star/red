generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  MONITOR
  RESEARCHER
}

enum ViolationSeverity {
  LOW
  MEDIUM
  HIGH
  CRIMINAL
}

enum SurveyType {
  CORAL
  FISH
  PLANT
  TURTLE
  WATER
}

model User {
  id              String   @id @default(cuid())
  employeeId      String   @unique
  passwordHash    String
  name            String
  nameAr          String   @default("")
  role              String   @default("MONITOR") // ADMIN, MONITOR, RESEARCHER, RANGER, MANAGER
  reserveId         String   @default("")
  reserve           String?
  reserveAr         String?
  status            String   @default("ACTIVE")
  email             String?
  customDomainEmail String?
  profilePictureUrl String?
  badges            String?  // JSON or comma-separated
  certifications    String?  // Comma-separated or JSON
  allowedSections   String?  // JSON
  lastActive        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  patrolsParticipated Patrol[] @relation("PatrolMembers")
  patrolsLed          Patrol[] @relation("PatrolLeader")
  patrolCrewMemberships PatrolCrew[]
  violationsReported  Violation[]
  surveysConducted    Survey[]
  emailRoutes         EmailRoute[]
  sentMessages        Message[] @relation("SentMessages")
  receivedMessages    Message[] @relation("ReceivedMessages")
}

model Patrol {
  id                String   @id @default(cuid())
  code              String?
  zone              String?
  zoneAr            String?
  reserveId         String   @default("")
  reserve           String   @default("")
  date              DateTime @default(now())
  type              String?  @default("Marine Patrol") // Marine Patrol, Coastal Patrol, Monitoring Patrol, Inspection Patrol
  startTime         DateTime @default(now())
  endTime           DateTime?
  weather           String?
  notes             String?
  status            String   @default("DRAFT")

  leaderId          String?
  customLeaderName  String?
  
  leader            User?    @relation("PatrolLeader", fields: [leaderId], references: [id])
  crew              PatrolCrew[]
  patrolObservations PatrolObservation[]
  patrolViolations   PatrolViolation[]
  attachments       PatrolAttachment[]
  route             PatrolRoute?
  
  // Legacy fields or backwards compatibility:
  vesselId          String?
  vessel            Vessel?  @relation(fields: [vesselId], references: [id])
  areaCovered       Float?
  duration          Float?
  incidentsReported Int      @default(0)
  routeCoordinates  String?  // old json string
  observations      String?
  members           User[]   @relation("PatrolMembers")
  violations        Violation[]
}

model PatrolCrew {
  id          String @id @default(cuid())
  patrolId    String
  userId      String

  patrol      Patrol @relation(fields: [patrolId], references: [id], onDelete: Cascade)
  user        User   @relation(fields: [userId], references: [id])
}

model PatrolObservation {
  id                 String   @id @default(cuid())
  patrolId           String
  speciesName        String
  count              Int
  observationTime    DateTime
  locationName       String
  latitude           Float
  longitude          Float
  behaviorNotes      String?
  photos             String?  // JSON array of URLs
  
  monitoringRecordId String?
  monitoringRecord   Observation? @relation(fields: [monitoringRecordId], references: [id])
  
  patrol             Patrol @relation(fields: [patrolId], references: [id], onDelete: Cascade)
}

model PatrolViolation {
  id                 String   @id @default(cuid())
  patrolId           String
  violatorName       String?
  vesselName         String?
  violationType      String
  violationDetails   String?
  dateTime           DateTime
  location           String?
  latitude           Float
  longitude          Float
  evidencePhotos     String? // JSON
  evidenceFiles      String? // JSON
  immediateAction    String?
  followupAction     String?
  status             String   @default("NEW")
  severity           String   @default("LOW")

  violationRecordId  String?
  violationRecord    Violation? @relation(fields: [violationRecordId], references: [id])

  patrol             Patrol @relation(fields: [patrolId], references: [id], onDelete: Cascade)
}

model PatrolAttachment {
  id          String @id @default(cuid())
  patrolId    String
  name        String
  url         String
  type        String // IMAGE, DOCUMENT
  
  patrol      Patrol @relation(fields: [patrolId], references: [id], onDelete: Cascade)
}

model PatrolRoute {
  id          String @id @default(cuid())
  patrolId    String @unique
  geojson     String // JSON representation
  startLat    Float?
  startLng    Float?
  endLat      Float?
  endLng      Float?
  
  patrol      Patrol @relation(fields: [patrolId], references: [id], onDelete: Cascade)
}

model Vessel {
  id              String   @id @default(cuid())
  code            String?
  name            String
  nameAr          String?
  regNumber       String   @unique
  type            String?
  status          String   @default("ACTIVE")
  fuelLevel       Float    @default(100)
  healthScore     Float    @default(100)
  engineHours     Float    @default(0)
  lastService     DateTime?
  
  patrols         Patrol[]
}

model Violation {
  id            String   @id @default(cuid())
  code          String?
  reserveId     String   @default("")
  reserve       String   @default("")
  date          DateTime @default(now())
  officerId     String
  locationLat   Float
  locationLng   Float
  types         String?
  typeAr        String?
  severity      String   @default("LOW") // LOW, MEDIUM, HIGH
  violatorName  String?
  vesselName    String?
  actionTaken   String?
  fineAmount    Float?
  status        String   @default("NEW")
  location      String?
  locationAr    String?
  description   String?

  officer       User     @relation(fields: [officerId], references: [id])
  patrolId      String?
  patrol        Patrol?  @relation(fields: [patrolId], references: [id])
  patrolViolations PatrolViolation[]
}

model Survey {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  reserveId   String   @default("")
  reserve     String   @default("")
  observerId  String
  type        SurveyType
  depthRange  String?
  visibility  Float?
  waterTemp   Float?
  ph          Float?
  salinity    Float?
  healthScore Float?

  observer    User     @relation(fields: [observerId], references: [id])
}

model EiaCost {
  id              String        @id @default(cuid())
  subject         String
  details         String
  reserveId       String   @default("")
  reserve         String   @default("")
  date            DateTime
  status          String        @default("UNANSWERED") // UNANSWERED, ANSWERED
  createdBy       String        @default("مصطفى لايق")
  updatedBy       String?
  isDeletePending Boolean       @default(false)
  deleteReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  files           EiaCostFile[]
}

model EmailRoute {
  id               String   @id @default(cuid())
  userId           String
  alias            String   @unique
  destinationEmail String
  description      String?
  status           String   @default("PENDING") // PENDING, ACTIVE, DISABLED
  cloudflareRuleId String?
  verified         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EiaCostFile {
  id        String   @id @default(cuid())
  name      String
  url       String
  costId    String
  cost      EiaCost  @relation(fields: [costId], references: [id], onDelete: Cascade)
}

model EiaInspection {
  id              String   @id @default(cuid())
  locationName    String
  latitude        Float
  reserveId       String   @default("")
  reserve         String   @default("")
  longitude       Float
  date            DateTime
  inspectorName   String
  studyFileUrl    String?
  reportFileUrl   String?
  createdBy       String   @default("مصطفى لايق")
  updatedBy       String?
  isDeletePending Boolean  @default(false)
  deleteReason    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EiaViolation {
  id              String             @id @default(cuid())
  type            String             // Beach encroachment, Scaffolding, Construction
  date            DateTime
  locationName    String
  reserveId       String   @default("")
  reserve         String   @default("")
  latitude        Float
  longitude       Float
  entityType      String             // PROJECT or PERSON
  entityName      String
  createdBy       String             @default("مصطفى لايق")
  updatedBy       String?
  isDeletePending Boolean            @default(false)
  deleteReason    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  files           EiaViolationFile[]
}

model EiaViolationFile {
  id          String       @id @default(cuid())
  name        String
  url         String
  violationId String
  violation   EiaViolation @relation(fields: [violationId], references: [id], onDelete: Cascade)
}

model EiaAccident {
  id              String   @id @default(cuid())
  type            String   // Grounding, Oil Pollution, Fires
  locationName    String
  latitude        Float
  reserveId       String   @default("")
  reserve         String   @default("")
  longitude       Float
  date            DateTime
  description     String
  reportFileUrl   String?
  createdBy       String   @default("مصطفى لايق")
  updatedBy       String?
  isDeletePending Boolean  @default(false)
  deleteReason    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NewsArticle {
  id         String   @id @default(cuid())
  title      String
  titleAr    String
  content    String
  contentAr  String
  category   String   // NEWS, EVENT, REPORT, REGULATION
  date       DateTime @default(now())
  authorId   String
  authorName String
  imageUrl   String?
  status     String   @default("DRAFT")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ReserveProfile {
  id              String   @id @default(cuid())
  name            String
  nameAr          String
  description     String
  descriptionAr   String
  location        String
  locationAr      String
  area            Float
  establishedYear Int
  imageUrl        String?
  status          String   @default("OPEN")
  coords          String   @default("")
  speciesCount    Int      @default(0)
  healthIndex     Float    @default(0.0)
  statusAr        String   @default("")
  activities      String   @default("")
  activitiesAr    String   @default("")
  rules           String   @default("")
  rulesAr         String   @default("")
  ticketPrice     String   @default("")
  ticketPriceAr   String   @default("")
  famousSpecies   String   @default("")
  famousSpeciesAr String   @default("")
  gallery         String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OpenDataDocument {
  id         String   @id @default(cuid())
  title      String
  titleAr    String
  type       String   // ACADEMIC, REPORT, DATASET, GUIDELINE
  fileUrl    String
  fileSize   Int
  uploadDate DateTime @default(now())
  uploaderId String
  status     String   @default("PUBLIC")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model VisitorGuideSection {
  id        String   @id @default(cuid())
  title     String
  titleAr   String
  content   String
  contentAr String
  order     Int
  links     String?  // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomepageSettings {
  id                    String   @id @default("home-config")
  heroTitle             String
  heroTitleAr           String
  heroSubtitle          String
  heroSubtitleAr        String
  heroAuthority         String   @default("Red Sea Marine Authority")
  heroAuthorityAr       String   @default("جهاز محميات البحر الأحمر")
