  heroBtn1Text          String   @default("Begin Exploration")
  heroBtn1TextAr        String   @default("ابدأ الاستكشاف")
  heroBtn1Link          String   @default("/guide")
  heroBtn2Text          String   @default("Interactive Map")
  heroBtn2TextAr        String   @default("خريطة المحميات")
  heroBtn2Link          String   @default("/reserves")
  
  statsJson             String   @default("[]") // JSON string of stats
  
  missionTag            String   @default("Protecting the Vision")
  missionTagAr          String   @default("حماية الرؤية المستقبلية")
  missionTitle          String   @default("Commitment to the Blue Heritage")
  missionTitleAr        String   @default("مهمتنا هي صون التراث الطبيعي")
